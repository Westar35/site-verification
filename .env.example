# HTTP-сервер
HTTP_ADDR=:8080

# MongoDB.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=dns-check-service
MONGO_COLLECTION=domains

# DNS-серверы для проверки TXT-записей (host:port).
# Можно указать несколько через запятую — опрашиваются по очереди с fallback:
# DNS_SERVERS=8.8.8.8:53,1.1.1.1:53
DNS_SERVERS=8.8.8.8:53
